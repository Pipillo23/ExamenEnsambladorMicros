# #####################################
        # SETUP EJERCICIO CONTEO CARACTERES
        # #####################################
        # Definicion de Direcciones de Memoria
        li      t0, 0x00FF0000
        li      t1, 0x00FF0000
        addi    t1, t1, 12              # 0xC = 12

        # Creacion y almacenamiento de la primera palabra ("AMaO")
        li      t2, 0x414D614F
        sw      t2, 0(t0)

        # Creacion y almacenamiento de la segunda palabra ("rzam")
        li      t2, 0x727A616D
        sw      t2, 4(t0)

        # Creacion y almacenamiento de la tercera palabra ("uBaM")
        li      t2, 0x7542614D
        sw      t2, 8(t0)

        # Creacion y almacenamiento de la cuarta palabra ("xKae")
        li      t2, 0x784B6165
        sw      t2, 12(t0)

        # Reinicio de registros según necesidades del ejercicio
        li      t2, 0

        # #####################################
        # ESPACIO PARA SOLUCION
        # #####################################
        # Estrategia general: Recorrer la memoria para cada letra de la A a la Z,
        # contando apariciones y actualizando el 1er y 2do puesto.

        # Inicialización de contadores máximos en 0
        li      s1, 0                   # R8 = 0 (Mayor cantidad)
        li      s2, 0                   # R9 = 0 (2da mayor cantidad)

        # Se inicia la evaluacion en la Letra A (0x41) y termina en Z (0x5A)
        li      s3, 0x41                # s3 = R3 (Carácter actual)

for_main:
        li      t0, 0x5A
        bgt     s3, t0, final

        # Salto a metodo conteo caracter (actualiza ra automáticamente)
        jal     ra, conteo_caracter

        # Se verifica si el conteo es el mayor existente (t3 vs s1)
        ble     t3, s1, check_second
        j       sustitucion_mayor_cantidad

check_second:
        # Se verifica si el conteo es el 2do mayor existente (t3 vs s2)
        ble     t3, s2, siguiente_ciclo
        # Se actualiza el 2do puesto de ser cierto
        mv      s5, s3                  # R11 = R3
        mv      s2, t3                  # R9 = R4
        j       siguiente_ciclo

        # Esta seccion mueve el antiguo caracter con mayor apariciones
        # a la segunda posicion y coloca el nuevo mayor caracter en su lugar
sustitucion_mayor_cantidad:
        mv      s5, s4                  # R11 = R10
        mv      s2, s1                  # R9 = R8
        mv      s4, s3                  # R10 = R3
        mv      s1, t3                  # R8 = R4
        j       siguiente_ciclo

        # Se encarga de incrementar a la siguiente letra
siguiente_ciclo:
        addi    s3, s3, 1
        j       for_main

        # Punto de fin del codigo
final:
        # Fin del programa

        # ######################################
        # METODO CONTEO_CARACTER
        # ######################################
        # Partiendo de un caracter ASCII en el registro s3, cuenta cuántas veces aparece
        # en el rango de memoria de t0 a t1.
conteo_caracter:
        li      t3, 0                   # R4 = 0 (Conteo de apariciones)
        mv      t2, t0                  # R2 = R0 (Puntero de lectura actual)
        addi    t6, s3, 0x20            # R7 = Versión minúscula del caracter

        # Usando R7+4 (t1 + 4) como condicion de parada para asegurar ver todos los bytes
        addi    t4, t1, 4               # R5 = R1 + 4

for_conteo_caracter:
        # La condicion de parada es cuando R2 alcance la direccion R5
        bge     t2, t4, fin_conteo      # Equivalente a MOVEQ PC, LR cuando se alcanza el límite

        # Se carga el byte actual y se incrementa el puntero de forma explícita (+1)
        lbu     t5, 0(t2)               # LDRB R6, [R2]
        addi    t2, t2, 1               # Post-incremento simulado de [#1]

        # Compara el caracter leído contra las versiones mayúscula y minúscula
        bne     t5, s3, check_lower
        addi    t3, t3, 1               # Si coincide con la mayúscula, incrementa conteo

check_lower:
        bne     t5, t6, for_conteo_caracter
        addi    t3, t3, 1               # Si coincide con la minúscula, incrementa conteo

        j       for_conteo_caracter

fin_conteo:
        ret                             # Retorno de subrutina (jr ra)
